# Local development defaults only. Never commit production credentials or tokens.
DATABASE_URL=postgresql://user:password@localhost:5432/rupaykg
DATABASE_SSL=false
PORT=3000
HOST=0.0.0.0

# Native RupayKG authentication is PostgreSQL-backed.
# No third-party identity-provider configuration is required.
RUPAYKG_AUTH_MODE=real

# Optional AI extraction provider. Disabled unless BASE_URL and MODEL are set.
# Compatible with an OpenAI-style /chat/completions endpoint (including a running
# local Ollama-compatible endpoint). No model is downloaded and no provider is
# selected automatically. Remote endpoints may incur charges; configure only
# an endpoint you have explicitly approved. Never commit real API keys.
# RUPAYKG_AI_BASE_URL=http://127.0.0.1:11434/v1
# RUPAYKG_AI_MODEL=<already-installed-model-id>
# RUPAYKG_AI_PROVIDER_ID=ollama-local
# RUPAYKG_AI_PROMPT_VERSION=waste-log-extraction-v1
# Prompt text is not stored in source. Configure both values via runtime secrets.
# Encrypt a private prompt file with scripts/encrypt-ai-prompt.mjs; never commit it.
# Keep this 32-byte key separate from the ciphertext where the secret manager allows.
# RUPAYKG_AI_PROMPT_KEY_HEX=<64-hex-character-random-key>
# RUPAYKG_AI_PROMPT_CIPHERTEXT=v1:<iv-hex>:<auth-tag-hex>:<ciphertext-hex>
# RUPAYKG_AI_API_KEY=

# Asynchronous government-data bridge. Configure a separate random secret per authorized authority.
# Each authority credential is bound to explicit municipalCodes; never reuse a secret across authorities.
# Signature: HMAC-SHA256(authoritySecret, timestampHeader + "." + JSON.stringify(parsedPayload)).
# This is bridge-side sender authentication, not proof of NAPIX/API Setu accreditation or official government approval.
# Store the real JSON in the deployment secret manager; never commit credentials.
# RUPAYKG_GOV_BRIDGE_AUTHORITY_CREDENTIALS='{"MH-PCB":{"secret":"<unique-random-secret-at-least-32-characters>","municipalCodes":["MCGM-MUM"]},"MPPCB":{"secret":"<different-random-secret-at-least-32-characters>","municipalCodes":["BHOPAL-MUNI"]}}'

# Guardian MRV integration. The submit URL must point to the deployed
# open-source Hedera Guardian MRV/policy workflow endpoint; never fabricate
# a Guardian decision locally.
GUARDIAN_MRV_SUBMIT_URL=http://localhost:3002/<configured-guardian-mrv-endpoint>
GUARDIAN_MRV_POLICY_ID=<guardian-policy-id>
# GUARDIAN_API_TOKEN=<server-side-guardian-api-token>

# Hedera HCS provenance. Writes are fail-closed until all real values exist.
HEDERA_NETWORK=testnet
HEDERA_TOPIC_ID=<hedera-topic-id>
HEDERA_OPERATOR_ID=<hedera-account-id>
HEDERA_OPERATOR_KEY=<hedera-private-key>

# Production-only contract (do not copy local values into production).
# NODE_ENV=production
# DATABASE_URL=postgresql://<managed-postgresql-host>:5432/rupaykg
# DATABASE_SSL=require
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----"
# RUPAYKG_AUTH_MODE=real
# RUPAYKG_ALLOWED_ORIGINS=https://<authoritative-web-origin>
# RUPAYKG_SYNTHETIC_DATA=false
# VITE_RUPAYKG_SESSION_TOKEN=   # MUST remain unset in production; client bundles are public

# Optional HTTPS webhook for government inbox worker operational alerts.
# Send only aggregate counts and error classes; never source evidence or credentials.
# If unset, alert conditions remain visible only as structured stdout logs.
# RUPAYKG_ALERT_WEBHOOK_URL=https://<approved-monitoring-endpoint>

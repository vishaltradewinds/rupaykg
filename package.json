{
  "name": "rupaykg",
  "version": "0.1.0",
  "private": true,
  "description": "India's Circular Economy Operating System",
  "packageManager": "npm@11",
  "workspaces": ["apps", "apps/web", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run build -w @rupaykg/domain && npm run build -w @rupaykg/carbon && npm run build -w @rupaykg/compliance && npm run build -w @rupaykg/esg && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "validate:migrations": "node scripts/validate-migrations.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}

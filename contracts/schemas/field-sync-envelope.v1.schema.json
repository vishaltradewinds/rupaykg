{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rupaykg.in/schemas/field-sync-envelope/v1",
  "title": "RupayKg Field Sync Envelope v1",
  "description": "Draft target contract for offline/online field operations. This schema is not yet attached to Fastify runtime validation and is not an approved external partner API contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "idempotencyKey",
    "deviceId",
    "clientSequence",
    "capturedAt",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "description": "Version of the field-operation envelope contract."
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Client-generated stable key scoped to the enrolled device. Reuse with identical payload returns the original result; reuse with a different payload is a conflict."
    },
    "deviceId": {
      "type": "string",
      "format": "uuid",
      "description": "Server-enrolled field_devices.id. The server must resolve identity and organization from the verified device record; this value is not proof of authority."
    },
    "clientSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Monotonic sequence generated by the device. A conflicting sequence must be recorded and rejected, never silently overwritten."
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Device capture time. The server separately records received_at and server_cursor."
    },
    "payload": {
      "oneOf": [
        { "$ref": "#/$defs/activityCreate" },
        { "$ref": "#/$defs/measurementCreate" },
        { "$ref": "#/$defs/evidenceCreate" },
        { "$ref": "#/$defs/resourceFlowCreate" }
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "activityCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationType", "organizationId", "activityType", "geographyId"],
      "properties": {
        "operationType": { "const": "ACTIVITY_CREATE" },
        "organizationId": {
          "$ref": "#/$defs/uuid",
          "description": "Declared target organization. Server must require equality with the authenticated active organization and the enrolled device's immutable organization binding."
        },
        "activityType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "geographyId": { "$ref": "#/$defs/uuid" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "measurementCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationType", "activityId", "value", "unit", "method", "source", "measuredAt"],
      "properties": {
        "operationType": { "const": "MEASUREMENT_CREATE" },
        "activityId": { "$ref": "#/$defs/uuid" },
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "method": { "type": "string", "minLength": 1, "maxLength": 160 },
        "source": { "type": "string", "minLength": 1, "maxLength": 160 },
        "measuredAt": { "type": "string", "format": "date-time" },
        "instrumentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Stable enrolled sensor/instrument identity; not a free-form client assertion of calibration or certification."
        },
        "calibrationEvidenceId": { "$ref": "#/$defs/uuid" },
        "uncertainty": { "type": "number", "minimum": 0 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "locationAccuracyM": { "type": "number", "minimum": 0 },
        "qualityStatus": { "enum": ["PENDING", "ACCEPTED", "REJECTED", "QUARANTINED"] },
        "methodologyVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
        "evidenceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "evidenceCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationType", "activityId", "evidenceType", "capturedAt"],
      "anyOf": [
        { "required": ["contentUri"] },
        { "required": ["contentHash"] }
      ],
      "properties": {
        "operationType": { "const": "EVIDENCE_CREATE" },
        "activityId": { "$ref": "#/$defs/uuid" },
        "measurementId": { "$ref": "#/$defs/uuid" },
        "evidenceType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "contentUri": { "type": "string", "format": "uri", "maxLength": 2048 },
        "contentHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "hashAlgorithm": { "const": "sha256" },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "resourceFlowCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationType", "organizationId", "originType", "resourceForm", "materialCode", "quantity", "unit"],
      "anyOf": [
        { "required": ["sourceGeographyId"] },
        { "required": ["destinationGeographyId"] }
      ],
      "properties": {
        "operationType": { "const": "RESOURCE_FLOW_CREATE" },
        "organizationId": {
          "$ref": "#/$defs/uuid",
          "description": "Declared target organization. Server must require equality with the authenticated active organization and the enrolled device's immutable organization binding."
        },
        "originType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "resourceForm": { "type": "string", "minLength": 1, "maxLength": 120 },
        "materialCode": { "type": "string", "minLength": 1, "maxLength": 120 },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "sourceGeographyId": { "$ref": "#/$defs/uuid" },
        "destinationGeographyId": { "$ref": "#/$defs/uuid" },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    }
  },
  "x-rupaykg-status": "draft-target-not-runtime-enforced",
  "x-rupaykg-release-gates": [
    "Attach this schema to Fastify runtime validation and generated OpenAPI.",
    "Bind device identity and immutable organization in the database transaction at intake and apply.",
    "Enforce idempotency and immutable envelope state in PostgreSQL.",
    "Persist actor, device, envelope, instrument, calibration, uncertainty and evidence provenance on authoritative domain records.",
    "Pass two-tenant/two-device PostgreSQL acceptance before external partner use."
  ]
}